# Copy this file to .env.local for local development.

# Local: the PGlite server started by `npm run db:local`.
# On Vercel: your Supabase "Transaction pooler" connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres

# Encrypts the login cookie. At least 32 random characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Weekly briefing (feature 9): a Google Cloud "OAuth client ID" of type
# "Web application". Optional: without these, Settings says Google isn't set up.
# Authorized redirect URIs: http://localhost:3000/api/google/callback
#                           https://steady-lime.vercel.app/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI prioritize (feature 10): an Anthropic API key from console.anthropic.com.
# Optional: without it, the "Help me prioritize" button says the AI isn't set up.
ANTHROPIC_API_KEY=
